<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>权限与追溯：谁能做、做错怎么办</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>四级层级 + 五类角色：权限按职务推导，越权在前端就拦下来</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='user-shield' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>第 3 章 · 协作与治理</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'row', gap: 26 }}>
        {/* 左 45% 层级 + 撤回机制 */}
        <Box style={{ width: 500, flexDirection: 'column', gap: 14 }}>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#F4F6F9', borderRadius: 10, border: '1px solid #E3E8F0', padding: 18 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1B4A8C', marginBottom: 12 }}>四级组织层级</Text>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
                    <Box style={{ width: 84, height: 30, borderRadius: 6, background: '#12294A', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF' }}>总 / 副总</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#5A6478' }}>全权限，可见全部案件</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 8 }}>
                    <Box style={{ width: 84, height: 30, borderRadius: 6, background: '#1B4A8C', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF' }}>组长</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#5A6478' }}>本组案件与待办管理</Text>
                </Box>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ width: 84, height: 30, borderRadius: 6, background: '#2E6BB0', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 15, color: '#FFFFFF' }}>员工</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#5A6478' }}>只看自己的案件与待办</Text>
                </Box>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#FFFFFF', borderRadius: 10, border: '1px solid #E3E8F0', borderLeft: '5px solid #C8A45C', padding: 18 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='clock-rotate-left' style={{ fill: '#C8A45C', width: 20, height: 20 }} />
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1F2733' }}>双快照撤回机制</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.7, marginTop: 10 }}>每个写操作都保存修改前 / 后的两份快照；撤回 = 把「修改前」原样写回。<br />撤回动作本身也记日志，所以「撤回」还能再被撤回（重做）。</Text>
            </Box>
        </Box>
        {/* 右 55% 权限矩阵 + 截图 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#F4F6F9', borderRadius: 10, border: '1px solid #E3E8F0', paddingTop: 14, paddingBottom: 14, paddingLeft: 16, paddingRight: 16 }}>
                <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1B4A8C', marginBottom: 10 }}>角色 × 能力矩阵</Text>
                <Table style={{ width: '100%', height: 168 }} defaultTextStyle={{ fontSize: 14, textAlign: 'center', color: '#1F2733' }} defaultCellStyle={{ border: { left: { width: 1, color: '#E3E8F0' }, right: { width: 1, color: '#E3E8F0' }, top: { width: 1, color: '#E3E8F0' }, bottom: { width: 1, color: '#E3E8F0' } } }} cells={[
                    [{ text: '角色', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1B4A8C' } } }, { text: '建案指派', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1B4A8C' } } }, { text: '提意见', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1B4A8C' } } }, { text: '确认流转', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1B4A8C' } } }, { text: '撤回操作', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1B4A8C' } } }],
                    ['全权限角色（领导层）', '可', '可', '可', '可'],
                    [{ text: '普通民警 STAFF', cellStyle: { background: { color: '#F4F6F9' } } }, '不可', { text: '不可', cellStyle: { background: { color: '#F4F6F9' } } }, { text: '不可', cellStyle: { background: { color: '#F4F6F9' } } }, { text: '仅本人', cellStyle: { background: { color: '#F4F6F9' } } }],
                    ['受限范围', '按职务与办案组', '按案件可见范围', '按层级', '按操作人'],
                ]} />
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', borderRadius: 10, overflow: 'hidden', border: '1px solid #E3E8F0', background: '#F4F6F9' }}>
                <Box style={{ flex: 1, overflow: 'hidden' }}>
                    <Image src='assets/ui-org.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'left top' }} />
                </Box>
                <Box style={{ width: 240, flexDirection: 'column', justifyContent: 'center', background: '#FFFFFF', padding: 18 }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1B4A8C', marginBottom: 10 }}>员工图谱</Text>
                    <Text style={{ fontSize: 15, color: '#5A6478', lineHeight: 1.65 }}>部门一律下拉选已有部门；办案组别决定可承办的案件类型。</Text>
                    <Text style={{ fontSize: 14, color: '#C8A45C', marginTop: 12 }}>部门异常自动标橙提示</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>13 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
