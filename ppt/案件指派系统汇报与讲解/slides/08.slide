<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>案件盯办：三类页签盯什么</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>刑事案件的盯办看板，按办理状态分三个页签逐类盯住</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='filter' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>第 2 章 · 核心机制</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'row', gap: 26 }}>
        {/* 左 58% 大图 */}
        <Box style={{ width: 664, flexDirection: 'column', borderRadius: 10, overflow: 'hidden', border: '1px solid #E3E8F0', background: '#F4F6F9' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, paddingLeft: 16, paddingTop: 12, paddingBottom: 12, background: 'linear-gradient(135deg, #1B4A8C 0%, #2E6BB0 100%)' }}>
                <FAIcon name='eye' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
                <Text style={{ fontSize: 16, color: '#FFFFFF' }}>案件盯办 · 刑事看板</Text>
                <Text style={{ marginLeft: 'auto', fontSize: 14, color: '#C9D6E8' }}>初查 / 刑拘在办 / 取保及监居</Text>
            </Box>
            <Box style={{ flex: 1, overflow: 'hidden' }}>
                <Image src='assets/ui-watch-criminal.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'left top' }} />
            </Box>
            <Box style={{ paddingLeft: 16, paddingRight: 16, paddingTop: 10, paddingBottom: 12, background: '#FFFFFF' }}>
                <Text style={{ fontSize: 15, color: '#8A94A6', lineHeight: 1.5 }}>四张计数卡 + 具体时限提醒 + 三张分布图，构成盯办第一屏。</Text>
            </Box>
        </Box>
        {/* 右 42% 三类页签 */}
        <Box style={{ flex: 1, flexDirection: 'column', gap: 14 }}>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #1B4A8C', padding: 16 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1B4A8C' }}>初查</Text>
                    <Text style={{ fontSize: 14, color: '#8A94A6' }}>计划逾期 / 有嫌疑人</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.6, marginTop: 8 }}>盯初查计划有没有按期启动、有没有锁定嫌疑人，逾期直接红字顶到前面。</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #2E6BB0', padding: 16 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#2E6BB0' }}>刑拘在办</Text>
                    <Text style={{ fontSize: 14, color: '#8A94A6' }}>临期 / 超期</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.6, marginTop: 8 }}>盯刑事拘留期间的措施期限，临期预警、超期高亮，避免超期羁押风险。</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'column', background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #C8A45C', padding: 16 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#C8A45C' }}>取保及监居</Text>
                    <Text style={{ fontSize: 14, color: '#8A94A6' }}>30 天内到期</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.6, marginTop: 8 }}>盯取保候审、监视居住的届满节点，提前 30 天进入提醒视野。</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 12, background: 'rgba(27,74,140,0.06)', borderRadius: 8, paddingTop: 13, paddingBottom: 13, paddingLeft: 16, paddingRight: 16 }}>
                <FAIcon name='bell' style={{ fill: '#1B4A8C', width: 20, height: 20 }} />
                <Text style={{ fontSize: 16, color: '#1B4A8C', flex: 1 }}>两个页签可切换：看板计数 / 页签列表，点计数卡直接筛。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>08 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
