<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>刑事 / 行政：两套完全不同的规则</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>先选大类，再选小类；选定后本栏目只统计该类案件</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='layer-group' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>三处分野</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'row', gap: 26 }}>
        {/* 左 60%：三处分野 */}
        <Box style={{ width: 676, flexDirection: 'column', gap: 16 }}>
            <Box style={{ width: '100%', flexDirection: 'row', background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18 }}>
                <Text style={{ width: 130, fontSize: 16, fontWeight: 'bold', color: '#8A94A6' }}>对比维度</Text>
                <Text style={{ width: 240, fontSize: 16, fontWeight: 'bold', color: '#1B4A8C' }}>刑事案件</Text>
                <Text style={{ flex: 1, fontSize: 16, fontWeight: 'bold', color: '#C8A45C' }}>行政案件</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #1B4A8C', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18 }}>
                <Text style={{ width: 130, fontSize: 17, fontWeight: 'bold', color: '#1F2733' }}>盯办方式</Text>
                <Text style={{ width: 240, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>初查 / 刑拘在办 / 取保监居<br />三类页签分别盯</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>呈批材料 → 行政处罚<br />单线盯办即可</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #2E6BB0', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18 }}>
                <Text style={{ width: 130, fontSize: 17, fontWeight: 'bold', color: '#1F2733' }}>期限规则</Text>
                <Text style={{ width: 240, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>取保 7 天 / 30 天<br />刑拘变更羁押 3 天 / 30 天</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>30 / 60 天办理时限<br />延期另计</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #C8A45C', paddingTop: 16, paddingBottom: 16, paddingLeft: 18, paddingRight: 18 }}>
                <Text style={{ width: 130, fontSize: 17, fontWeight: 'bold', color: '#1F2733' }}>流转出口</Text>
                <Text style={{ width: 240, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>初查 → 刑拘 → 取保<br />→ 移送审查起诉</Text>
                <Text style={{ flex: 1, fontSize: 16, color: '#5A6478', lineHeight: 1.55 }}>呈批 → 处罚决定<br />→ 执行归档</Text>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 12, background: 'rgba(27,74,140,0.06)', borderRadius: 8, paddingTop: 14, paddingBottom: 14, paddingLeft: 18, paddingRight: 18 }}>
                <FAIcon name='info-circle' style={{ fill: '#1B4A8C', width: 20, height: 20 }} />
                <Text style={{ fontSize: 16, color: '#1B4A8C', lineHeight: 1.5, flex: 1 }}>另有「其他案件」用于未立案等非刑事、非行政情形，口径独立统计。</Text>
            </Box>
        </Box>
        {/* 右 40%：选型截图 */}
        <Box style={{ flex: 1, flexDirection: 'column', borderRadius: 10, overflow: 'hidden', border: '1px solid #E3E8F0', background: '#F4F6F9' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, paddingLeft: 16, paddingTop: 12, paddingBottom: 12, background: 'linear-gradient(135deg, #1B4A8C 0%, #2E6BB0 100%)' }}>
                <FAIcon name='hand-pointer' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
                <Text style={{ fontSize: 16, color: '#FFFFFF' }}>选择案件类型</Text>
            </Box>
            <Box style={{ flex: 1, overflow: 'hidden' }}>
                <Image src='assets/ui-type-picker.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'center top' }} />
            </Box>
            <Box style={{ paddingLeft: 16, paddingRight: 16, paddingTop: 10, paddingBottom: 12, background: '#FFFFFF' }}>
                <Text style={{ fontSize: 15, color: '#8A94A6', lineHeight: 1.5 }}>大类 → 小类两级卡片进入，退出时逐级退回。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>07 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
