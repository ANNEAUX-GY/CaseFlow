<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>从收到案子到办结：全链路</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>六个节点串成一条闭环，每一步都有责任人、都有时间戳</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='project-diagram' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>全链路闭环</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'column', gap: 20 }}>
        {/* 流程图主视觉 */}
        <Box style={{ width: '100%', flexDirection: 'column', background: '#F4F6F9', borderRadius: 10, border: '1px solid #E3E8F0', paddingTop: 22, paddingBottom: 22, paddingLeft: 24, paddingRight: 24 }}>
            <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1B4A8C', marginBottom: 16 }}>主链路</Text>
            <svg width={1100} height={168} viewBox='0 0 1100 168'>
                <defs>
                    <marker id='arw' markerWidth='9' markerHeight='9' refX='7' refY='4.5' orient='auto'>
                        <path d='M0,0 L9,4.5 L0,9 z' fill='#2E6BB0' />
                    </marker>
                </defs>
                <line x1='150' y1='62' x2='196' y2='62' stroke='#2E6BB0' strokeWidth='2.5' markerEnd='url(#arw)' />
                <line x1='330' y1='62' x2='376' y2='62' stroke='#2E6BB0' strokeWidth='2.5' markerEnd='url(#arw)' />
                <line x1='510' y1='62' x2='556' y2='62' stroke='#2E6BB0' strokeWidth='2.5' markerEnd='url(#arw)' />
                <line x1='690' y1='62' x2='736' y2='62' stroke='#2E6BB0' strokeWidth='2.5' markerEnd='url(#arw)' />
                <line x1='870' y1='62' x2='916' y2='62' stroke='#2E6BB0' strokeWidth='2.5' markerEnd='url(#arw)' />
                <g>
                    <rect x='10' y='36' width='140' height='52' rx='8' fill='#1B4A8C' />
                    <text x='80' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>① 收案</text>
                </g>
                <g>
                    <rect x='200' y='36' width='130' height='52' rx='8' fill='#1B4A8C' />
                    <text x='265' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>② 指派</text>
                </g>
                <g>
                    <rect x='380' y='36' width='130' height='52' rx='8' fill='#2E6BB0' />
                    <text x='445' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>③ 建待办</text>
                </g>
                <g>
                    <rect x='560' y='36' width='130' height='52' rx='8' fill='#1B4A8C' />
                    <text x='625' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>④ 盯版本</text>
                </g>
                <g>
                    <rect x='740' y='36' width='130' height='52' rx='8' fill='#2E6BB0' />
                    <text x='805' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>⑤ 流转</text>
                </g>
                <g>
                    <rect x='920' y='36' width='150' height='52' rx='8' fill='#C8A45C' />
                    <text x='995' y='68' fill='#FFFFFF' fontSize='19' fontWeight='bold' textAnchor='middle'>⑥ 办结</text>
                </g>
                <text x='80' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>录入 / 导入</text>
                <text x='265' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>主办 + 协办</text>
                <text x='445' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>意见派生</text>
                <text x='625' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>逐条反馈</text>
                <text x='805' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>领导确认</text>
                <text x='995' y='112' fill='#8A94A6' fontSize='14' textAnchor='middle'>归档留痕</text>
                <path d='M995,132 L995,152 L80,152 L80,132' fill='none' stroke='#C8A45C' strokeWidth='1.5' strokeDasharray='6 5' />
                <text x='540' y='164' fill='#C8A45C' fontSize='13' textAnchor='middle'>全过程可追溯 · 每一步都留操作日志</text>
            </svg>
        </Box>
        {/* 三点说明 */}
        <Box style={{ width: '100%', flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 1, flexDirection: 'column', background: '#FFFFFF', border: '1px solid #E3E8F0', borderRadius: 8, padding: 18 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='bullseye' style={{ fill: '#1B4A8C', width: 22, height: 22 }} />
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>责任到人</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.65, marginTop: 10 }}>指派环节同时确定主办与协办，谁在办、谁协办一屏可见。</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', background: '#F4F6F9', border: '1px solid #E3E8F0', borderRadius: 8, padding: 18 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='clock' style={{ fill: '#2E6BB0', width: 22, height: 22 }} />
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>节点限时</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.65, marginTop: 10 }}>每个阶段挂计时基准，临期变橙、逾期变红，自动推送到人。</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', background: '#FFFFFF', border: '1px solid #E3E8F0', borderRadius: 8, padding: 18 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <FAIcon name='history' style={{ fill: '#C8A45C', width: 22, height: 22 }} />
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>可撤回重做</Text>
                </Box>
                <Text style={{ fontSize: 16, color: '#5A6478', lineHeight: 1.65, marginTop: 10 }}>误操作一键撤回，系统记录前后快照，撤回动作本身也留痕。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>05 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
