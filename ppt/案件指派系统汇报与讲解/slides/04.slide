<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    {/* B 标题块 */}
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>系统定位：一条链路管到底</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>把散落在表格、微信群、纸质台账里的案子，收进同一条可追踪的链路</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='briefcase' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>第 1 章 · 系统全貌</Text>
        </Box>
    </Box>
    {/* C 内容区 */}
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'row', gap: 28 }}>
        {/* 左：四段链路 */}
        <Box style={{ width: 520, flexDirection: 'column', gap: 14 }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F4F6F9', borderRadius: 8, borderLeft: '5px solid #1B4A8C', padding: 16 }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#1B4A8C', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='inbox' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F2733' }}>收案</Text>
                    <Text style={{ fontSize: 15, color: '#8A94A6', marginTop: 4 }}>录入或导入案件，标注刑事 / 行政</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #2E6BB0', padding: 16 }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#2E6BB0', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='users' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F2733' }}>指派</Text>
                    <Text style={{ fontSize: 15, color: '#8A94A6', marginTop: 4 }}>定主办 + 协办，按层级与办案组派工</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F4F6F9', borderRadius: 8, borderLeft: '5px solid #1B4A8C', padding: 16 }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#1B4A8C', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='eye' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F2733' }}>盯办</Text>
                    <Text style={{ fontSize: 15, color: '#8A94A6', marginTop: 4 }}>意见派生成待办，到期自动预警</Text>
                </Box>
            </Box>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', borderLeft: '5px solid #C8A45C', padding: 16 }}>
                <Box style={{ width: 44, height: 44, borderRadius: 8, background: '#C8A45C', justifyContent: 'center', alignItems: 'center' }}>
                    <FAIcon name='check-circle' style={{ fill: '#FFFFFF', width: 22, height: 22 }} />
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1F2733' }}>办结</Text>
                    <Text style={{ fontSize: 15, color: '#8A94A6', marginTop: 4 }}>阶段完成 → 领导确认 → 归档留痕</Text>
                </Box>
            </Box>
        </Box>
        {/* 右：工作台截图 */}
        <Box style={{ flex: 1, flexDirection: 'column', borderRadius: 10, overflow: 'hidden', border: '1px solid #E3E8F0', background: '#F4F6F9' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, paddingLeft: 16, paddingTop: 12, paddingBottom: 12, background: 'linear-gradient(135deg, #1B4A8C 0%, #2E6BB0 100%)' }}>
                <FAIcon name='desktop' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
                <Text style={{ fontSize: 16, color: '#FFFFFF' }}>工作台：全部案件的入口</Text>
            </Box>
            <Box style={{ flex: 1, overflow: 'hidden' }}>
                <Image src='assets/ui-dashboard.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'left top' }} />
            </Box>
            <Box style={{ paddingLeft: 16, paddingRight: 16, paddingTop: 10, paddingBottom: 12, background: '#FFFFFF' }}>
                <Text style={{ fontSize: 15, color: '#8A94A6' }}>案件总数 / 待指派 / 已逾期 / 今日到期，一眼看清手头压力。</Text>
            </Box>
        </Box>
    </Box>
    {/* D 页脚 */}
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>04 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
