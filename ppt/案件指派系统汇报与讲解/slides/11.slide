<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#FFFFFF', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', left: 0, top: 0, width: 1280, height: 8, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 8, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 8, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 8, background: '#C8A45C' }} />
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 40, width: 1152, height: 76, flexDirection: 'row', alignItems: 'center', gap: 20 }}>
        <Box style={{ width: 6, height: 44, background: '#1B4A8C' }} />
        <Box style={{ flexDirection: 'column' }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1F2733', lineHeight: 1.2 }}>意见 → 待办：一件事不落地</Text>
            <Text style={{ fontSize: 16, color: '#8A94A6', marginTop: 6 }}>领导提的意见不会停在嘴上——它会变成一条有责任人、有截止时间的待办</Text>
        </Box>
        <Box style={{ marginLeft: 'auto', flexDirection: 'row', alignItems: 'center', gap: 10, background: '#F4F6F9', borderRadius: 6, paddingLeft: 14, paddingRight: 14, paddingTop: 8, paddingBottom: 8 }}>
            <FAIcon name='stream' style={{ fill: '#1B4A8C', width: 18, height: 18 }} />
            <Text style={{ fontSize: 14, color: '#1B4A8C' }}>闭环四步</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 132, width: 1152, height: 532, flexDirection: 'row', gap: 26 }}>
        {/* 左 65% 闭环四步 */}
        <Box style={{ width: 736, flexDirection: 'column', gap: 13 }}>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 16, background: 'linear-gradient(135deg, #1B4A8C 0%, #2E6BB0 100%)', borderRadius: 8, paddingTop: 15, paddingBottom: 15, paddingLeft: 18, paddingRight: 18 }}>
                <Box style={{ width: 32, height: 32, borderRadius: 16, background: 'rgba(255,255,255,0.22)', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#FFFFFF' }}>领导提出意见</Text>
                    <Text style={{ fontSize: 15, color: '#D9E4F2', marginTop: 3 }}>在案件详情里写意见，可指定承办人、截止时间、紧急与重点程度</Text>
                </Box>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', paddingTop: 15, paddingBottom: 15, paddingLeft: 18, paddingRight: 18 }}>
                <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#1B4A8C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>系统自动派生待办</Text>
                    <Text style={{ fontSize: 15, color: '#5A6478', marginTop: 3 }}>意见 = 待办的唯一来源，自动推送到承办人的「我的待办」</Text>
                </Box>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', borderRadius: 8, border: '1px solid #E3E8F0', paddingTop: 15, paddingBottom: 15, paddingLeft: 18, paddingRight: 18 }}>
                <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#2E6BB0', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>民警反馈 + 勾选子任务</Text>
                    <Text style={{ fontSize: 15, color: '#5A6478', marginTop: 3 }}>每条任务要写反馈才能勾完成，子任务全部完成才推进主任务</Text>
                </Box>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F4F6F9', borderRadius: 8, border: '1px solid #E3E8F0', paddingTop: 15, paddingBottom: 15, paddingLeft: 18, paddingRight: 18 }}>
                <Box style={{ width: 32, height: 32, borderRadius: 16, background: '#C8A45C', justifyContent: 'center', alignItems: 'center' }}>
                    <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>4</Text>
                </Box>
                <Box style={{ flexDirection: 'column', flex: 1 }}>
                    <Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1F2733' }}>领导确认，任务闭环</Text>
                    <Text style={{ fontSize: 15, color: '#5A6478', marginTop: 3 }}>由领导勾选确认才真正关闭，未确认的任务一直亮在待办里</Text>
                </Box>
            </Box>
            <Box style={{ width: '100%', flexDirection: 'row', alignItems: 'center', gap: 12, background: 'rgba(200,164,92,0.12)', borderRadius: 8, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18 }}>
                <FAIcon name='lock' style={{ fill: '#C8A45C', width: 20, height: 20 }} />
                <Text style={{ fontSize: 16, color: '#8A6A24', flex: 1 }}>权限分层：主任务只有管理层能建，子任务归承办人；越权在前端就被挡。</Text>
            </Box>
        </Box>
        {/* 右 35% 截图 */}
        <Box style={{ flex: 1, flexDirection: 'column', borderRadius: 10, overflow: 'hidden', border: '1px solid #E3E8F0', background: '#F4F6F9' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, paddingLeft: 16, paddingTop: 12, paddingBottom: 12, background: 'linear-gradient(135deg, #1B4A8C 0%, #2E6BB0 100%)' }}>
                <FAIcon name='tasks' style={{ fill: '#FFFFFF', width: 18, height: 18 }} />
                <Text style={{ fontSize: 16, color: '#FFFFFF' }}>我的待办</Text>
            </Box>
            <Box style={{ flex: 1, overflow: 'hidden' }}>
                <Image src='assets/ui-staff-todos.png' style={{ width: '100%', height: '100%', objectFit: 'cover', objectPosition: 'left top' }} />
            </Box>
            <Box style={{ paddingLeft: 16, paddingRight: 16, paddingTop: 10, paddingBottom: 12, background: '#FFFFFF' }}>
                <Text style={{ fontSize: 15, color: '#8A94A6', lineHeight: 1.5 }}>紧急优先、重点优先、截止临近，系统排好序再推给民警。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 676, width: 1152, height: 32, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>案件指派系统　·　功能汇报与使用讲解</Text>
        <Text style={{ fontSize: 14, color: '#8A94A6' }}>11 / 16</Text>
    </Box>
    <Box style={{ position: 'absolute', left: 64, top: 712, width: 1152, height: 6, flexDirection: 'row' }}>
        <Box style={{ width: '55%', height: 6, background: '#1B4A8C' }} />
        <Box style={{ width: '25%', height: 6, background: '#2E6BB0' }} />
        <Box style={{ width: '20%', height: 6, background: '#C8A45C' }} />
    </Box>
</Slide>
