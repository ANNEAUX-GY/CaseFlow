# ============================================================
# CaseFlow 案件指派系统 · 环境变量示例
# ============================================================
# 复制本文件为 .env 或直接在系统/终端中设置对应环境变量。
# 注意：本项目默认「零配置启动」，以下所有变量都有安全默认值，
#       日常开发通常无需设置，仅在需要覆盖默认行为时使用。
#
# 后端读取方式：Spring Boot 标准环境变量（见 application.yml）。
# 前端读取方式：Vite（VITE_ 前缀变量，见 vite.config.js）。

# ---------- 后端 ----------

# 后端服务端口（默认 8080）
# 刻意用 CF_SERVER_PORT 而非 SERVER_PORT，避免与某些 IDE/工具
# 注入的 SERVER_PORT 环境变量冲突导致服务跑到随机端口。
#CF_SERVER_PORT=8080

# Spring 激活的配置 profile（默认 dev = 内置 H2 文件库，零安装）
# 生产/正式使用 MySQL 时设为 mysql，并配合下方数据库连接变量。
#SPRING_PROFILES_ACTIVE=dev

# 附件上传目录（默认 ./data/uploads，相对应用启动目录）
#CASEFLOW_UPLOAD_DIR=./data/uploads

# ---------- MySQL（仅 SPRING_PROFILES_ACTIVE=mysql 时需要）----------
# 与 application-mysql.yml 对应，按需覆盖：
#SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/caseflow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
#SPRING_DATASOURCE_USERNAME=root
#SPRING_DATASOURCE_PASSWORD=yourpassword

# ---------- 前端（Vite，可选的覆盖项）----------

# 后端地址，供 Vite 开发代理使用（默认 http://127.0.0.1:8080）
#VITE_BACKEND=http://127.0.0.1:8080
